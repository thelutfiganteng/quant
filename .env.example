# =============================================================================
# Macro Quant Trading System — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL + TimescaleDB connection string
DATABASE_URL=postgresql+asyncpg://mquser:mqpass@localhost:5432/macro_quant
# Sync URL for Alembic migrations (uses psycopg2)
DATABASE_URL_SYNC=postgresql+psycopg2://mquser:mqpass@localhost:5432/macro_quant
TIMESCALEDB_ENABLED=true

# --- FRED API ---
# Get your free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# --- BLS API ---
# Register at: https://data.bls.gov/registrationEngine/
# Optional but recommended (higher rate limits)
BLS_API_KEY=your_bls_api_key_here

# --- Trading Economics API ---
# Sign up at: https://tradingeconomics.com/analytics/api.aspx
# Leave empty to use fallback mode (no consensus data)
TRADING_ECONOMICS_API_KEY=

# --- Polygon.io API ---
# Get your free API key at: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# --- ADP Research (Optional) ---
# ADP_API_KEY=
